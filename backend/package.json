{
  "name": "payit-backend",
  "version": "1.0.0",
  "description": "PayIT Telegram Bot + API Backend — Monad Blockchain",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
