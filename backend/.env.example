# ─── Telegram ────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather

# ─── Monad Network ───────────────────────────────────────────────────────────
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_CHAIN_ID=10143
# For mainnet:
# MONAD_RPC_URL=https://rpc.monad.xyz
# MONAD_CHAIN_ID=143

# ─── Operator Wallet (Backend Signer) ────────────────────────────────────────
# This wallet relays contract calls. Fund it with MON for gas.
# NEVER commit the real key. Use a secrets manager in production.
OPERATOR_PRIVATE_KEY=0xYOUR_OPERATOR_PRIVATE_KEY

# ─── Smart Contracts ─────────────────────────────────────────────────────────
# Set these after running: forge script script/Deploy.s.sol --broadcast
INVOICE_LEDGER_ADDRESS=0x0000000000000000000000000000000000000000
ESCROW_ADDRESS=0x0000000000000000000000000000000000000000
# Testnet: deploy MockUSDC, set that address here
# Mainnet: 0x754704Bc059F8C67012fEd69BC8A327a5aafb603 (Circle native USDC on Monad)
USDC_ADDRESS=0x0000000000000000000000000000000000000000

# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgresql://payit:payit_password@localhost:5432/payit_db

# ─── Security ────────────────────────────────────────────────────────────────
# 32+ random bytes, used for JWT signing
JWT_SECRET=change_me_to_a_32_character_random_string
# Separate secret for magic links
MAGIC_LINK_SECRET=change_me_to_another_32_char_random_string
# Session token for grammY bot sessions
SESSION_SECRET=change_me_yet_again

# ─── AI (Groq) ───────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_your_groq_api_key
# Set to "false" to disable AI assistant if key is unavailable
AI_ENABLED=true

# ─── On-ramp / Off-ramp ──────────────────────────────────────────────────────
# "stub" for development (no real money movement)
# "flutterwave" or "paystack" for production
RAMP_PROVIDER=stub
RAMP_API_KEY=
RAMP_SECRET_KEY=
RAMP_WEBHOOK_SECRET=

# ─── Tax Defaults ────────────────────────────────────────────────────────────
# Nigerian VAT rate: 7.5%
VAT_RATE=0.075
# Default WHT for professional services: 5%
WHT_DEFAULT_RATE=0.05

# ─── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
DASHBOARD_URL=http://localhost:5173
BOT_WEBHOOK_URL=

# ─── Escrow ──────────────────────────────────────────────────────────────────
# Default expiry for pending transfers (seconds). 14 days = 1209600
ESCROW_DEFAULT_EXPIRY_SECONDS=1209600

# ─── Rate Limiting ───────────────────────────────────────────────────────────
# Max failed PIN attempts before lockout
PIN_MAX_ATTEMPTS=5
# Lockout duration in minutes
PIN_LOCKOUT_MINUTES=15
